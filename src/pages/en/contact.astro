---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactPage from "../../views/pages/ContactPage.jsx";
import { ROUTES } from "../../i18n/routes.js";
---

<BaseLayout locale="en" seoKey="contact" esPath={ROUTES.contact.es} enPath={ROUTES.contact.en}>
  <ContactPage locale="en" currentPath={Astro.url.pathname} paths={{ es: ROUTES.contact.es, en: ROUTES.contact.en }} client:load />
</BaseLayout>
