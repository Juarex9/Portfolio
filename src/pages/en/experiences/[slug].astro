---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ExperiencePage from "../../../views/pages/ExperiencePage.jsx";
import { experienceStaticPaths } from "../../../lib/staticPaths.js";
import { experiencePath } from "../../../i18n/routes.js";
import { t } from "../../../i18n/t.js";

export function getStaticPaths() {
  return experienceStaticPaths();
}

const { slug } = Astro.params;
const title = t("en", `experiences.items.${slug}.seo.title`);
const description = t("en", `experiences.items.${slug}.seo.description`);
const esPath = experiencePath(slug, "es");
const enPath = experiencePath(slug, "en");
---

<BaseLayout locale="en" title={title} description={description} esPath={esPath} enPath={enPath}>
  <ExperiencePage slug={slug} locale="en" currentPath={Astro.url.pathname} paths={{ es: esPath, en: enPath }} client:load />
</BaseLayout>
