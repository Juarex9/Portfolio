---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePage from "../views/pages/HomePage.jsx";
import { ROUTES } from "../i18n/routes.js";
---

<BaseLayout locale="es" seoKey="home" esPath={ROUTES.home.es} enPath={ROUTES.home.en}>
  <HomePage locale="es" currentPath={Astro.url.pathname} paths={{ es: ROUTES.home.es, en: ROUTES.home.en }} client:load />
</BaseLayout>
